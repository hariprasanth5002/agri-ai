# ───────────────────────────────────────────────────
# Frontend Environment Variables — Agri AI
# ───────────────────────────────────────────────────

# REQUIRED: Your deployed Render backend URL.
# Must use HTTPS in production (Vercel enforces HTTPS, geolocation requires HTTPS).
# Do NOT include a trailing slash.
#
# For local development: http://localhost:8001
# For production (Vercel): set this in Vercel Dashboard → Project → Settings → Environment Variables
#
# Variable name: VITE_API_BASE_URL   ← MUST be exactly this name
# Example value: https://agri-ai-t4n7.onrender.com
VITE_API_BASE_URL=https://agri-ai-t4n7.onrender.com
